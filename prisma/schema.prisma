// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id        String        @id @default(cuid())
  name      String
  type      String        // "INCOME" | "EXPENSE"
  icon      String
  color     String
  defaultAmount Float?    
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  transactions   Transaction[]
  budgets        Budget[]
  recurring      RecurringTransaction[]
  templates      TransactionTemplate[]
  splits         TransactionSplit[]

  @@index([type])
}

model Account {
  id          String        @id @default(cuid())
  name        String
  type        String        // "CASH" | "BANK" | "EWALLET" | "INVESTMENT"
  icon        String
  color       String
  balance     Float         @default(0)
  isDefault   Boolean       @default(false)
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  transactions       Transaction[]
  transfersOut       Transfer[] @relation("FromAccount")
  transfersIn        Transfer[] @relation("ToAccount")
  recurring          RecurringTransaction[]
  templates          TransactionTemplate[]

  @@index([type])
}

model Transfer {
  id          String   @id @default(cuid())
  fromAccountId String
  toAccountId   String
  amount       Float
  date        DateTime
  note        String?
  fee         Float    @default(0)
  createdAt   DateTime @default(now())
  fromAccount Account  @relation("FromAccount", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount   Account  @relation("ToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)

  @@index([date])
}

model Transaction {
  id          String   @id @default(cuid())
  type        String   // "INCOME" | "EXPENSE"
  amount      Float
  description String
  date        DateTime
  categoryId  String
  accountId   String?
  note        String?
  tags        String?  // comma-separated tag names
  merchant    String?
  isRecurringGenerated Boolean @default(false)

  // Per-transaction attributes (new)
  time        String?  // "HH:mm" — time of transaction
  // Media
  photoUrl    String?  // base64 or URL of receipt photo
  // Context
  mood        String?  // "happy" | "neutral" | "stressed" | "excited" | "sad"
  priority    String?  // "URGENT" | "NEED" | "WANT"
  // Payment
  paymentStatus String? @default("PAID") // "PAID" | "PENDING" | "SCHEDULED" | "FAILED"
  paymentMethod String? // "CASH" | "TRANSFER" | "QRIS" | "DEBIT" | "CREDIT" | "EWALLET"
  recipient   String?  // person/entity
  // Multi-currency
  currency    String   @default("IDR")
  originalAmount Float?  // amount in original currency
  exchangeRate Float?    // rate to IDR
  // Relations (splits, groups, linked, installments, debts)
  parentTransactionId String?  // for splits / linked transactions
  groupId    String?   // TransactionGroup id (event grouping)
  installmentId String?  // installment plan id
  // Flags
  isSplit     Boolean  @default(false) // this is a parent of splits
  isDebt      Boolean  @default(false) // marks a debt/loan transaction
  isReimbursable Boolean @default(false)
  reimbursed  Boolean  @default(false)
  isSubscription Boolean @default(false)
  isTaxDeductible Boolean @default(false)
  isBusinessExpense Boolean @default(false)
  excludeFromBudget Boolean @default(false)
  excludeFromStats Boolean @default(false)
  isPinned    Boolean  @default(false)
  // Money tracking extras
  cashbackAmount Float? 
  originalPrice Float?    // before discount
  discountAmount Float?  
  // Debt fields
  debtDueDate DateTime?
  creditor    String?  // who you owe / who owes you
  // Goal allocation
  goalId      String?  
  // Assignment
  assignedTo  String?  // person name
  // Status
  status      String   @default("CONFIRMED") // "DRAFT" | "SCHEDULED" | "CONFIRMED"
  // Link
  linkUrl     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  splits      TransactionSplit[]
  group       TransactionGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  installment Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  receiptItems ReceiptItem[]

  @@index([type])
  @@index([date])
  @@index([categoryId])
  @@index([accountId])
  @@index([merchant])
  @@index([mood])
  @@index([priority])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([groupId])
  @@index([installmentId])
  @@index([isPinned])
  @@index([isDebt])
  @@index([isSubscription])
}

model TransactionSplit {
  id              String   @id @default(cuid())
  parentTransactionId String
  amount          Float
  categoryId      String
  note            String?
  createdAt       DateTime @default(now())
  parentTransaction Transaction @relation(fields: [parentTransactionId], references: [id], onDelete: Cascade)
  category        Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([parentTransactionId])
}

model TransactionGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#10b981")
  icon        String   @default("Folder")
  createdAt   DateTime @default(now())
  transactions Transaction[]
}

model Installment {
  id              String   @id @default(cuid())
  description     String
  totalAmount     Float
  totalInstallments Int
  paidInstallments Int    @default(0)
  monthlyAmount   Float
  startDate       DateTime
  endDate         DateTime?
  accountId       String?
  categoryId      String
  merchant        String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  transactions    Transaction[]
}

model Debt {
  id          String   @id @default(cuid())
  type        String   // "DEBT" (you owe) | "RECEIVABLE" (owed to you)
  person      String   // creditor / debtor name
  amount      Float
  paidAmount  Float    @default(0)
  dueDate    DateTime?
  description String?
  note       String?
  settled    Boolean  @default(false)
  linkedTransactionId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([settled])
}

model TransactionTemplate {
  id          String   @id @default(cuid())
  name        String
  type        String   // "INCOME" | "EXPENSE"
  amount      Float    @default(0)
  description String
  categoryId  String
  accountId   String?
  merchant    String?
  paymentMethod String?
  priority    String?
  icon        String   @default("Zap")
  createdAt   DateTime @default(now())
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([type])
}

model ReceiptItem {
  id          String   @id @default(cuid())
  transactionId String
  name        String
  qty         Float    @default(1)
  price       Float
  total       Float
  createdAt   DateTime @default(now())
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

model Budget {
  id         String   @id @default(cuid())
  categoryId String
  amount     Float
  period     String   @default("MONTHLY")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model Goal {
  id          String   @id @default(cuid())
  name        String
  targetAmount Float
  currentAmount Float  @default(0)
  targetDate  DateTime?
  icon        String   @default("Target")
  color       String   @default("#10b981")
  note        String?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RecurringTransaction {
  id          String   @id @default(cuid())
  type        String   // "INCOME" | "EXPENSE"
  amount      Float
  description String
  categoryId  String
  accountId   String?
  frequency   String   // "DAILY" | "WEEKLY" | "MONTHLY" | "YEARLY"
  interval    Int      @default(1)
  startDate   DateTime
  nextDate    DateTime
  endDate     DateTime?
  note        String?
  active      Boolean  @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([nextDate])
  @@index([active])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#6b7280")
  createdAt DateTime @default(now())
}

model Setting {
  id    String @id
  value String
}

model SecuritySetting {
  id              String   @id
  value           String
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // "LOGIN_SUCCESS" | "LOGIN_FAILED" | "LOGOUT" | "EXPORT" | "DELETE_TX" | "PIN_CHANGE" | "WIPE" | etc.
  detail      String?
  ipAddress   String?
  userAgent   String?
  success     Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model TrustedDevice {
  id            String   @id @default(cuid())
  name          String
  fingerprint   String   @unique // device fingerprint hash
  trustedUntil  DateTime
  lastSeen      DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([fingerprint])
}

model BiometricCredential {
  id          String   @id @default(cuid())
  name        String
  credentialId String  @unique // base64url
  publicKey   String   // base64url
  counter     Int      @default(0)
  createdAt   DateTime @default(now())
}
